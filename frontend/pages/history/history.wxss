page { background: #F5F7F7; }

.history-page { 
  min-height: 100vh; 
  padding: 20rpx; 
  padding-bottom: 100rpx;
  box-sizing: border-box; 
  width: 100vw; 
  overflow-x: hidden; 
}

/* 顶部横幅 */
.patient-banner {
  display: flex; align-items: center; background: rgba(0, 191, 165, 0.1);
  padding: 24rpx 30rpx; border-radius: 16rpx; margin-bottom: 30rpx;
  border: 2rpx solid rgba(0, 191, 165, 0.2); box-sizing: border-box; width: 100%;
}
.banner-icon { font-size: 36rpx; margin-right: 16rpx; }
.banner-text { font-size: 30rpx; font-weight: bold; color: #00BFA5; }

/* 操作栏与强制排版 */

.action-bar { 
  display: flex; justify-content: space-between; align-items: center; 
  padding: 20rpx 24rpx; background: white; border-radius: 16rpx; 
  margin-bottom: 30rpx; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.03);
  box-sizing: border-box; width: 100%;
}

.select-all { 
  display: flex; flex-direction: row; align-items: center; flex-wrap: nowrap;
  flex-shrink: 0; min-width: 120rpx; 
}
.top-check { transform: scale(0.85); margin-right: 8rpx; flex-shrink: 0; }
.sel-txt { font-size: 28rpx; color: #333; white-space: nowrap; flex-shrink: 0; }

.btn-group {
  display: flex; gap: 16rpx; flex-wrap: nowrap;
  justify-content: flex-end; align-items: center; flex: 1;
}

.mini-btn {
  font-size: 24rpx; padding: 0 24rpx; height: 56rpx; line-height: 56rpx;
  border-radius: 28rpx; white-space: nowrap; flex-shrink: 0;
  text-align: center; font-weight: bold; transition: all 0.2s;
}

.download { background: #E0F2F1; color: #00897B; }
.delete { background: #FFEBEE; color: #E53935; }
.mini-btn.disabled { background: #F5F5F5; color: #BDBDBD; pointer-events: none; }
.mini-btn:active { opacity: 0.7; transform: scale(0.95); }

.empty-state { text-align: center; margin-top: 200rpx; color: #999;}
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx;}

/* 下方记录卡片排版 */
.record-item {
  display: flex; align-items: center; margin-bottom: 24rpx;
  width: 100%; box-sizing: border-box;
}

.check-box-wrapper { width: 60rpx; flex-shrink: 0; }
.item-check { transform: scale(0.85); }

.record-card { 
  background: white; border-radius: 20rpx; padding: 24rpx; 
  display: flex; align-items: center; box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.04);
  box-sizing: border-box; flex: 1; min-width: 0;
}
.record-card:active { opacity: 0.7; background-color: #FAFAFA; }

.thumb { width: 130rpx; height: 130rpx; border-radius: 12rpx; background: #eee; margin-right: 20rpx; flex-shrink: 0;}

.info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center;}

.time { font-size: 24rpx; color: #888; margin-bottom: 6rpx;}
.score { font-size: 28rpx; font-weight: bold; margin-bottom: 6rpx;}
.score.safe { color: #00BFA5; }
.score.danger { color: #F44336; }
.summary { font-size: 24rpx; color: #555; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;}
.arrow { color: #ccc; margin-left: 16rpx; flex-shrink: 0; font-weight: bold; font-family: "Courier New", Courier, monospace;}

.ios-action-row {
  display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx;
}
.ios-btn {
  font-size: 22rpx; font-weight: 500; padding: 0 26rpx; height: 50rpx; line-height: 50rpx;
  border-radius: 25rpx; background: #F2F2F7; transition: all 0.2s;
  white-space: nowrap; box-sizing: border-box; text-align: center;
}
.ios-btn:active { opacity: 0.6; transform: scale(0.95); }
.ios-down { color: #007AFF; }
.ios-del { color: #FF3B30; }

/* 提升隐藏画布高度至 4000px 防长图截断 */
.offscreen-canvas { position: fixed; left: -9999px; width: 750px; height: 4000px;}