<view class="page-container">
  <view class="header-bg">
    <view class="user-info" bindtap="goToMine">
      <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/mine.png'}}"></image>
      <view class="text-info">
        <text class="name">Hi, {{userInfo.realName || userInfo.nickName || '健康守护者'}} 👋</text>
        <text class="subtitle">今天也要好好爱护牙齿哦 🦷 | 最新评分: <text class="score-highlight">{{latestScore}}</text> 分</text>
      </view>
    </view>
  </view>

  <view class="main-content">
    
    <view class="banner-container">
      <swiper class="banner-swiper" indicator-dots="true" indicator-active-color="#00BFA5" indicator-color="rgba(255,255,255,0.5)" autoplay="true" circular="true" interval="4000">
        <swiper-item wx:for="{{banners}}" wx:key="title">
          <view class="banner-item">
            <image class="banner-img" src="{{item.image}}" mode="aspectFill"></image>
            <view class="banner-mask"></view>
            <view class="banner-text">
              <text class="banner-title">{{item.title}}</text>
              <text class="banner-subtitle">{{item.subtitle}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="tips-card">
      <text class="tips-icon">💡</text>
      <text class="tips-text">{{dailyTip}}</text>
    </view>

    <view class="nav-grid">
      <view class="grid-item" bindtap="startScreening">
        <view class="icon-box active-box"><text class="icon-txt">📷</text></view>
        <text class="grid-name">AI 影像识别</text>
      </view>
      
      <view class="grid-item" bindtap="goToTimer">
        <view class="icon-box"><text class="icon-txt">⏱️</text></view>
        <text class="grid-name">刷牙计时</text>
      </view>
      <view class="grid-item" bindtap="goToHistory">
        <view class="icon-box"><text class="icon-txt">📊</text></view>
        <text class="grid-name">历史档案</text>
      </view>
      <view class="grid-item" bindtap="goToForum">
        <view class="icon-box"><text class="icon-txt">💬</text></view>
        <text class="grid-name">匿名牙友</text>
      </view>
    </view>

    <view class="health-trend-card">
      <view class="trend-header">
        <text class="trend-title">我的口腔健康趋势</text>
        <text class="arrow" bindtap="goToHistory">管理记录 〉</text>
      </view>
      
      <view class="trend-content" wx:if="{{hasData}}">
        <canvas type="2d" id="trendChart" class="trend-canvas"></canvas>
      </view>
      <view class="empty-state" wx:else>
        <text class="empty-icon">📊</text>
        <text class="empty-text">暂无数据，快去进行第一次 AI 筛查吧</text>
        <button class="btn-primary" bindtap="startScreening">立即检测</button>
      </view>
    </view>

    <view class="section-header">
      <view class="title-left">
        <text class="icon-tv">📺</text>
        <text class="main-title">口腔科普小课堂</text>
      </view>
      <view class="title-right" bindtap="showWIP">
        <text class="more-text">查看全部</text>
        <text class="arrow">></text>
       </view>
    </view>

    <view class="video-list">
      <view class="video-card" wx:for="{{videos}}" wx:key="id">
        <video class="edu-video" src="{{item.url}}" poster="{{item.cover}}" title="{{item.title}}" preload="metadata" object-fit="cover" controls></video>
        <view class="video-info">
          <text class="video-title">{{item.title}}</text>
          <view class="video-stats">
            <text class="video-views">👁️ {{item.views}} 播放</text>
            <button class="video-share-btn" open-type="share" data-video="{{item}}">
              <text>↪️ 转发</text>
            </button>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>