/* 强制锁定根节点背景，彻底杜绝白屏 */
page { background: #050B14; height: 100%; }

.stats-page { min-height: 100vh; background-image: radial-gradient(circle at top, #111D27 0%, #03060A 100%); padding: 40rpx 30rpx; box-sizing: border-box; }

/* 概览面板 */
.overview-panel { display: flex; justify-content: space-between; background: rgba(0, 230, 184, 0.05); border: 2rpx solid rgba(0, 230, 184, 0.2); border-radius: 24rpx; padding: 40rpx 30rpx; margin-bottom: 40rpx; box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.5); }
.overview-item { display: flex; flex-direction: column; align-items: center; flex: 1; border-right: 2rpx solid rgba(255,255,255,0.05); }
.overview-item:last-child { border-right: none; }
.value { font-size: 48rpx; font-weight: bold; color: #00E6B8; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; text-shadow: 0 0 10rpx rgba(0, 230, 184, 0.4); margin-bottom: 8rpx; }
.label { font-size: 24rpx; color: rgba(255,255,255,0.6); }

/* 面板通用 */
.chart-panel, .list-panel { background: rgba(255, 255, 255, 0.03); border: 2rpx solid rgba(255, 255, 255, 0.05); border-radius: 24rpx; padding: 30rpx; margin-bottom: 40rpx; }
.panel-title { font-size: 30rpx; font-weight: bold; color: #FFFFFF; margin-bottom: 30rpx; display: flex; align-items: center; }
.panel-title .icon { margin-right: 12rpx; font-size: 34rpx; }

/* 曲线图表 */
.canvas-container { width: 100%; height: 400rpx; }
.brush-canvas { width: 100%; height: 100%; }

/* 列表 */
.record-list { display: flex; flex-direction: column; gap: 20rpx; }
.record-item { display: flex; justify-content: space-between; align-items: center; background: rgba(0, 0, 0, 0.3); padding: 24rpx 30rpx; border-radius: 16rpx; border-left: 6rpx solid rgba(0, 230, 184, 0.5); }
.record-left { display: flex; align-items: center; }
.record-icon { font-size: 40rpx; margin-right: 20rpx; opacity: 0.8; }
.record-info { display: flex; flex-direction: column; }
.record-date { font-size: 28rpx; color: #E0E0E0; font-weight: 500; margin-bottom: 4rpx; }
.record-time { font-size: 22rpx; color: rgba(255,255,255,0.4); }
.duration-tag { padding: 6rpx 16rpx; border-radius: 20rpx; font-size: 24rpx; font-weight: bold; }
.duration-tag.perfect { background: rgba(0, 230, 184, 0.15); color: #00E6B8; border: 2rpx solid rgba(0, 230, 184, 0.4); }
.duration-tag.good { background: rgba(255, 171, 0, 0.15); color: #FFAB00; border: 2rpx solid rgba(255, 171, 0, 0.4); }
.empty-tip { text-align: center; color: rgba(255,255,255,0.3); font-size: 26rpx; padding: 40rpx 0; }