.camera-container {
  min-height: 100vh; background-color: #1A1C1E; display: flex; flex-direction: column; align-items: center; padding: 60rpx 40rpx; box-sizing: border-box;
}

.header-tip {
  color: #FFFFFF; font-size: 34rpx; font-weight: bold; margin-bottom: 40rpx; letter-spacing: 2rpx;
}

.camera-wrapper {
  width: 100%; height: 750rpx; position: relative; border-radius: 40rpx; overflow: hidden; margin-bottom: 50rpx; border: 4rpx solid rgba(0, 191, 165, 0.3); box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
}

.live-camera {
  width: 100%; height: 100%; z-index: 1;
}

.scan-frame {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 550rpx; height: 500rpx; z-index: 10;
}

.corner { position: absolute; width: 40rpx; height: 40rpx; border: 4rpx solid #00BFA5; }
.top-left { top: 0; left: 0; border-right: none; border-bottom: none; }
.top-right { top: 0; right: 0; border-left: none; border-bottom: none; }
.bottom-left { bottom: 0; left: 0; border-right: none; border-top: none; }
.bottom-right { bottom: 0; right: 0; border-left: none; border-top: none; }

.guide-wrapper {
  position: absolute; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 40rpx 0; box-sizing: border-box;
}

.eye-guide-line { width: 100%; border-bottom: 2rpx dashed rgba(255, 255, 255, 0.4); text-align: center; padding-bottom: 10rpx; }
.guide-text { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8); }

.mouth-guide-box {
  width: 85%; height: 180rpx; margin: 0 auto; border: 4rpx dashed rgba(0, 191, 165, 0.6); background: rgba(0, 191, 165, 0.15); border-radius: 20rpx; display: flex; justify-content: center; align-items: center; margin-bottom: 20rpx; box-shadow: inset 0 0 20rpx rgba(0, 191, 165, 0.2);
}
.focus-text { color: #00BFA5; font-weight: bold; font-size: 26rpx; }

.center-line { position: absolute; top: 50%; left: 10%; right: 10%; height: 2rpx; background: rgba(0, 191, 165, 0.2); }
.cross-hair-vertical { position: absolute; left: 50%; top: 30%; bottom: 30%; width: 2rpx; background: rgba(0, 191, 165, 0.2); }

.instruction-card { width: 100%; background: #2A2D30; border-radius: 24rpx; padding: 30rpx; box-sizing: border-box; margin-bottom: 50rpx; }
.inst-title { color: #FFFFFF; font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
.inst-list { display: flex; flex-direction: column; gap: 16rpx; }
.inst-item { color: rgba(255,255,255,0.7); font-size: 24rpx; display: flex; align-items: center; }
.dot { width: 12rpx; height: 12rpx; background: #00BFA5; border-radius: 50%; margin-right: 16rpx; }

.btn-group { display: flex; width: 100%; gap: 20rpx; }
.capture-btn { flex: 2; height: 100rpx; background: #00BFA5; color: white; border-radius: 50rpx; display: flex; justify-content: center; align-items: center; font-size: 32rpx; font-weight: bold; box-shadow: 0 8rpx 24rpx rgba(0, 191, 165, 0.3); margin: 0;}
.capture-btn .icon { margin-right: 12rpx; font-size: 36rpx; }
.album-btn { flex: 1; height: 100rpx; background: #3A3D40; color: white; border-radius: 50rpx; display: flex; justify-content: center; align-items: center; font-size: 28rpx; font-weight: bold; margin: 0; border: 2rpx solid #555;}

/* 隐藏抠图黑板 */
.offscreen-canvas { position: fixed; left: -9999px; width: 1000px; height: 1000px; }

.flip-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  background: rgba(0, 0, 0, 0.5);
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.flip-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
}

/* 左上角：手电筒补光按钮样式 */
.flash-btn {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  background: rgba(0, 0, 0, 0.5);
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.flash-text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
}