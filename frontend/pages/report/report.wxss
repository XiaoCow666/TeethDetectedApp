.report-page { min-height: 100vh; background: #F5F7F7; padding-bottom: 80rpx; }

.score-header { display: flex; flex-direction: column; align-items: center; padding: 60rpx 0; color: #fff; transition: background 0.3s; }
.score-circle { width: 160rpx; height: 160rpx; border: 8rpx solid rgba(255,255,255,0.3); border-radius: 50%; display: flex; justify-content: center; align-items: center; margin-bottom: 20rpx; }
.num { font-size: 64rpx; font-weight: bold; }
.summary { font-size: 28rpx; opacity: 0.9; }

.card { background: #fff; margin: 30rpx; border-radius: 20rpx; padding: 30rpx; box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.03); }
.card-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 24rpx; }

/* 问题标签列表样式 */
.issues-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.issue-tag { background: rgba(255, 77, 79, 0.1); color: #FF4D4F; padding: 12rpx 24rpx; border-radius: 8rpx; font-size: 26rpx; font-weight: bold; border: 1rpx solid rgba(255, 77, 79, 0.3); }

.image-wrapper { position: relative; width: 100%; border-radius: 12rpx; overflow: hidden; background: #000; display: block; }
.origin-img { width: 100%; display: block; }

.bbox { position: absolute; border: 4rpx solid #FF4D4F; box-sizing: border-box; }
.bbox .label { position: absolute; left: -4rpx; top: -40rpx; background: rgba(255,77,79,0.9); color: #fff; font-size: 20rpx; padding: 4rpx 8rpx; font-weight: bold; border-top-left-radius: 8rpx; border-top-right-radius: 8rpx; white-space: nowrap; }

.advice-content { font-size: 28rpx; color: #555; line-height: 1.6; text-align: justify; }

.disclaimer-box { margin: 30rpx; padding: 30rpx; background: #FFF9C4; border-radius: 12rpx; border-left: 10rpx solid #FBC02D; }
.disclaimer-box .title { display: block; font-weight: bold; color: #856404; font-size: 28rpx; margin-bottom: 10rpx; }
.disclaimer-box .content { font-size: 24rpx; color: #856404; line-height: 1.6; }

.btn-group { display: flex; justify-content: space-between; align-items: center; padding: 0 30rpx; margin-top: 60rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.action-btn { flex: 1; height: 90rpx; line-height: 90rpx; font-size: 28rpx; border-radius: 45rpx; background: #00BFA5; color: #fff; font-weight: bold; text-align: center; }

/* 🌟 新增：AI 悬浮按钮样式 */
.ai-fab {
  position: fixed;
  bottom: 180rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #00BFA5, #009688);
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 191, 165, 0.4);
  z-index: 999;
}
.ai-fab .ai-icon { font-size: 36rpx; margin-right: 12rpx; }
.ai-fab .ai-text { font-size: 28rpx; font-weight: bold; }