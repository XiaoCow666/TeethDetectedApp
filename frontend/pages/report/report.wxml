<view class="report-page" wx:if="{{report}}">
  <view class="score-header" style="background: {{statusColor}}">
    <view class="score-circle"><text class="num">{{report.health_score}}</text></view>
    <text class="summary">诊断状态：{{statusText}}</text>
  </view>

  <view class="card">
    <view class="card-title">🎯 2D 靶向定位图</view>
    <view class="image-wrapper">
      <image src="{{imagePath}}" mode="widthFix" class="origin-img"></image>
      <view wx:for="{{report.bboxes}}" wx:key="index" class="bbox" 
            style="left:{{item.box[0]*100}}%; top:{{item.box[1]*100}}%; width:{{(item.box[2]-item.box[0])*100}}%; height:{{(item.box[3]-item.box[1])*100}}%;">
        <text class="label">{{item.tag}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{report.issues && report.issues.length > 0}}">
    <view class="card-title">🚨 发现的口腔问题</view>
    <view class="issues-list">
      <text class="issue-tag" wx:for="{{report.issues}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">💡 智能分析建议</view>
    <view class="advice-content">
      {{report.summary || report.advice || '发现初期口腔问题，建议近期多加关注并保持良好卫生习惯。'}}
    </view>
  </view>

  <view class="disclaimer-box">
    <text class="title">⚠️ 免责声明</text>
    <text class="content">本报告由 AI 算法生成，仅供辅助筛查参考，不具备临床诊断效力。如感不适，请前往正规医疗机构就诊。</text>
  </view>

  <view class="btn-group">
    <button class="action-btn download-btn" bindtap="saveReportToAlbum">📥 保存报告</button>
    <button class="action-btn share-btn" open-type="share">↪️ 分享好友</button>
  </view>

  <view class="ai-fab" bindtap="goToChat">
    <text class="ai-icon">💬</text>
    <text class="ai-text">对报告有疑问？点我问AI</text>
  </view>

  <canvas type="2d" id="posterCanvas" style="width: 750px; height: 4000px; position: fixed; left: -9999px;"></canvas>
</view>