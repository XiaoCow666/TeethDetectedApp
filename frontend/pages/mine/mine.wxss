.mine-page { min-height: 100vh; background: #F5F7F7; padding: 40rpx 30rpx; }
.header { display: flex; justify-content: center; margin-bottom: 60rpx; margin-top: 40rpx; }

.avatar-btn { background-color: transparent !important; padding: 0 !important; margin: 0 !important; line-height: normal !important; border: none !important; width: auto !important; overflow: visible !important; }
.avatar-btn::after { border: none !important; }
.avatar { width: 180rpx; height: 180rpx; border-radius: 50%; border: 6rpx solid #00BFA5; box-shadow: 0 8rpx 20rpx rgba(0, 191, 165, 0.2); display: block; }
.edit-tip { font-size: 24rpx; color: #999; text-align: center; margin-top: 16rpx; }

.card { background: #fff; border-radius: 24rpx; padding: 40rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); }
.card-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 30rpx; }

.form-group { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; border-bottom: 2rpx solid #F0F0F0; }
.form-group:last-child { border-bottom: none; padding-bottom: 0; }
.label { width: 160rpx; font-size: 28rpx; color: #333; }
.input { flex: 1; font-size: 28rpx; color: #333; text-align: right; width: 100%; }
.picker-wrap { flex: 1; width: 100%; }
.picker { width: 100%; font-size: 28rpx; color: #333; text-align: right; }
.placeholder { color: #999; }

.menu-card { padding: 10rpx 40rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; border-bottom: 2rpx solid #F0F0F0; font-size: 30rpx; color: #333; background: transparent; line-height: normal; text-align: left; }
.menu-item:last-child { border-bottom: none; }
.menu-item::after { border: none; }
.arrow { color: #ccc; font-size: 24rpx; }

.family-list {
  display: flex;
  flex-direction: column;
}

.family-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.family-info {
  display: flex;
  align-items: center;
}

.family-name {
  font-size: 30rpx;
  color: #333;
  margin-right: 20rpx;
}

/* 小巧的绿色标签 */
.family-tag {
  font-size: 20rpx;
  color: #00BFA5;
  background: rgba(0, 191, 165, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.family-arrow {
  display: flex;
  align-items: center;
}

.arrow-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部灰色极简按钮 */
.add-family-btn {
  margin-top: 30rpx;
  height: 88rpx;
  background: #F9FAFA;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #666;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.add-family-btn:active {
  background: #F0F0F0;
}