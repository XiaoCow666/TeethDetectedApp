/* 免责声明样式 */
.disclaimer-box {
  margin: 30rpx;
  padding: 30rpx;
  background: #FFF9C4;
  border-radius: 12rpx;
  border-left: 10rpx solid #FBC02D;
}
.disclaimer-box .title {
  display: block;
  font-weight: bold;
  color: #856404;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}
.disclaimer-box .content {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.6;
}

/* 按钮组 */
.btn-group { padding: 30rpx; }
.save-btn {
  background: #00BFA5;
  color: white;
  border-radius: 50rpx;
  font-weight: bold;
}